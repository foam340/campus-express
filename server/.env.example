NODE_ENV=production
PORT=5500
TRUST_PROXY=1

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=campus_express
DB_USER=campus_express
DB_PASSWORD=REPLACE_WITH_DATABASE_PASSWORD
DB_CONNECTION_LIMIT=10

ADMIN_JWT_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
ADMIN_JWT_EXPIRES_IN=2h
ADMIN_CORS_ORIGIN=https://admin.example.edu
MINI_JWT_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
MINI_JWT_EXPIRES_IN=30d
MINI_REGISTRATION_EXPIRES_IN=15m

WECHAT_APP_ID=REPLACE_WITH_WECHAT_APP_ID
WECHAT_APP_SECRET=REPLACE_WITH_WECHAT_APP_SECRET
WECHAT_REQUEST_TIMEOUT=8000

UPLOAD_DIR=/www/services/campus-express-api/uploads
UPLOAD_MAX_FILE_BYTES=5242880

XORPAY_AID=REPLACE_WITH_XORPAY_AID
XORPAY_SECRET=REPLACE_WITH_XORPAY_SECRET
MANUAL_PAYOUT_MODE=true

URGENT_EMAIL_ENABLED=false
SMTP_HOST=REPLACE_WITH_SMTP_HOST
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=REPLACE_WITH_SMTP_USER
SMTP_PASS=REPLACE_WITH_SMTP_AUTH_SECRET
SMTP_FROM=REPLACE_WITH_SMTP_FROM_EMAIL
URGENT_EMAIL_TO=REPLACE_WITH_ALERT_EMAIL
# 可选：新提现申请提醒收件人；留空关闭，复用上述 SMTP，无扫描或自动重试。
WITHDRAWAL_REQUEST_EMAIL_TO=

LOG_LEVEL=info
