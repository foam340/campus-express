@import "styles/variables.wxss";
@import "styles/utilities.wxss";

page {
  min-height: 100%;
  overflow-x: hidden;
  background: var(--color-bg);
  color: var(--color-text);
  font-size: 28rpx;
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
  -webkit-tap-highlight-color: transparent;
}

view, text, image, button, input, textarea, picker, scroll-view {
  box-sizing: border-box;
  min-width: 0;
}

button::after { border: 0; }

.page {
  min-height: 100vh;
  width: 100%;
  padding: 24rpx 24rpx calc(128rpx + env(safe-area-inset-bottom));
}

/* 高频 tab 切换只做极短淡入，不移动整页内容，减少“页面还在赶路”的迟滞感。 */
@keyframes page-enter {
  from { opacity: 0.92; }
  to { opacity: 1; }
}
.home-page, .orders-page, .profile-page, .tasks-page, .hall-page {
  animation: page-enter 120ms ease-out both;
}

.card {
  background: var(--color-surface);
  border-radius: var(--radius-card);
  padding: 30rpx;
  box-shadow: 0 12rpx 36rpx var(--shadow-color);
}

.section-title {
  font-size: 32rpx;
  line-height: 1.3;
  font-weight: 700;
  letter-spacing: -0.02em;
  color: var(--color-text);
}

.muted { color: var(--color-muted); }
.small { font-size: 24rpx; }
.strong { font-weight: 700; }

.primary-btn, .secondary-btn, .danger-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 92rpx;
  border-radius: 24rpx;
  font-size: 30rpx;
  font-weight: 700;
  text-align: center;
  transition: transform 100ms var(--ease), opacity 100ms ease;
}

.primary-btn:active, .secondary-btn:active, .danger-btn:active { transform: scale(0.98); opacity: 0.9; }

.primary-btn { color: var(--color-on-accent); background: var(--color-primary); }
.secondary-btn { color: var(--color-primary); background: var(--color-primary-soft); }
.danger-btn { color: var(--color-danger); background: var(--color-danger-soft); }
.disabled-btn { color: var(--color-hint) !important; background: var(--color-surface-2) !important; }

.tag {
  display: inline-flex;
  align-items: center;
  height: 46rpx;
  padding: 0 18rpx;
  border-radius: 23rpx;
  font-size: 22rpx;
  font-weight: 700;
}
.tag-blue { color: var(--color-primary); background: var(--color-primary-soft); }
.tag-orange { color: var(--color-warning); background: var(--color-warning-soft); }
.tag-green { color: var(--color-success); background: var(--color-success-soft); }
.tag-red { color: var(--color-danger); background: var(--color-danger-soft); }
/* purple / gray 取自订单列表组件的 .purple/.gray（接单大厅「不送上楼 / 送上楼」那对），
   组件样式隔离，详情页用不了，故在全局补一份同类色，保证两处标签观感一致 */
.tag-purple { color: var(--color-purple); background: var(--color-purple-soft); }
.tag-gray { color: var(--color-text-2); background: var(--color-gray-soft); }

.row { display: flex; align-items: center; }
.between { justify-content: space-between; }
.divider { height: 1rpx; background: var(--color-divider); margin: 26rpx 0; }
.safe-bottom { height: 40rpx; }
.text-ellipsis { overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }

/* 骨架屏占位：灰色块 + 微光扫过 */
.sk-list { display:flex; flex-direction:column; gap:20rpx; padding:8rpx 0; }
.sk { position:relative; overflow:hidden; background:var(--color-surface-2); border-radius:16rpx; }
.sk::after { content:''; position:absolute; left:0; top:0; right:0; bottom:0; transform:translateX(-100%); background:linear-gradient(90deg, transparent, rgba(255,255,255,.55), transparent); animation:sk-shimmer 1.3s infinite; }
.sk-row { height:240rpx; }
.sk-title { height:40rpx; width:44%; margin-bottom:26rpx; }
.sk-line { height:28rpx; margin-bottom:16rpx; }
.sk-line.short { width:62%; }
@keyframes sk-shimmer { 100% { transform:translateX(100%); } }

@media (prefers-reduced-motion: reduce) {
  .home-page, .orders-page, .profile-page, .tasks-page, .hall-page { animation: none; }
  .primary-btn, .secondary-btn, .danger-btn { transition: none; }
  .sk::after { animation: none; }
}
