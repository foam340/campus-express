.tasks-page { height:100vh; padding-top:26rpx; overflow:hidden; }
.summary { display:flex; align-items:center; justify-content:space-between; gap:18rpx; margin:0 4rpx 24rpx; }
.summary>view:first-child { flex:1; min-width:0; }
.summary-title { font-size:42rpx; font-weight:800; }
.summary-sub { margin-top:6rpx; color:var(--color-muted); font-size:23rpx; }
.count { flex:none; display:flex; align-items:center; justify-content:center; width:94rpx; height:76rpx; border-radius:24rpx; color:var(--color-primary); background:var(--color-surface); font-size:36rpx; font-weight:800; }
.count text { color:var(--color-hint); font-size:22rpx; }
.task-list { width:100%; height:calc(100vh - 245rpx - env(safe-area-inset-bottom)); }
.list-stage { position:relative; width:100%; }
.list-hidden { visibility:hidden; pointer-events:none; }
.empty-layer { position:absolute; z-index:2; top:30rpx; left:0; right:0; }
.recycle-row { display:block; width:100%; box-sizing:border-box; }
.task-row { height:230rpx; padding-bottom:20rpx; }
.load-more { padding:24rpx 0 36rpx; color:var(--color-hint); font-size:22rpx; text-align:center; }
