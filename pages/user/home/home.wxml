<page-meta page-style="{{pageMetaStyle}}" background-color="{{pageBackgroundColor}}" root-background-color="{{pageBackgroundColor}}" />
<network-banner />
<view class="page home-page">
  <view class="top-row">
    <view>
      <view class="hello">你好，{{user.name}}</view>
      <view class="address">{{user.building}}{{user.room}} <text class="change" bindtap="goProfile">修改</text></view>
    </view>
    <!-- 下单时间窗，固定 08:00—20:00。注意别改回 closeTime：那是「最晚送达时间」(23:00)，两者不是一回事。
         用户 2026-09-12 明确要求写死、以后不再改动；真要调窗口得手工回来改这一行 -->
    <view class="service-pill">{{reviewMode ? '可登记时间 08:00—20:00' : '可下单时间 08:00—20:00'}}</view>
  </view>

  <view wx:if="{{serviceClosed}}" class="service-closed-banner">
    <view class="service-closed-icon">⚠️</view>
    <view class="service-closed-text">{{serviceNotice || '节假日小程序暂停服务，恢复时间另行通知'}}</view>
  </view>

  <view class="hero {{serviceClosed ? 'hero-closed' : ''}}" bindtap="goCreate">
    <view class="hero-copy">
      <view class="hero-kicker">CAMPUS EXPRESS</view>
      <view class="hero-title">{{reviewMode ? '我要登记' : '我要找代拿'}}</view>
      <view class="hero-sub">{{reviewMode ? '添加取件凭证，登记一条快递信息' : '上传截图，最快 1 小时送到宿舍门口'}}</view>
      <view class="hero-action">{{serviceClosed ? '暂停服务' : (reviewMode ? '提交登记' : '现在下单')}}<text wx:if="{{!serviceClosed}}">→</text></view>
    </view>
    <!-- 右上角纸箱贴纸：新设计元素，纯装饰，随整卡一起响应 goCreate -->
    <view wx:if="{{!reviewMode}}" class="hero-box">📦</view>
  </view>

  <view class="section-head row between">
    <view class="section-title">{{reviewMode ? '当前登记' : '当前订单'}}</view>
    <view class="all-link" bindtap="goOrders">{{reviewMode ? '全部登记' : '全部订单'}}</view>
  </view>

  <view wx:if="{{activeOrder}}" class="card active-card" bindtap="goOrder">
    <view class="row between">
      <view class="tag tag-blue">{{activeOrder.statusText}}</view>
      <view class="order-no">{{activeOrder.id}}</view>
    </view>
    <view class="route-row">
      <view class="route-dot start"></view>
      <view class="route-line"></view>
      <view class="route-dot end"></view>
      <view class="route-copy">
        <view>{{activeOrder.pieces}}件快递</view>
        <view>{{activeOrder.building}}{{activeOrder.room}}</view>
      </view>
    </view>
    <view class="divider"></view>
    <view class="row between">
      <view>
        <view class="deadline-label">{{reviewMode ? '预计完成' : '预计送达'}}</view>
        <view class="deadline">{{activeOrder.deadline}}</view>
      </view>
      <view class="detail-btn">查看进度</view>
    </view>
  </view>

  <!-- 骨架屏：形状对齐真实订单卡（状态胶囊 / 两行路线 / 底部「预计送达 + 查看进度」），
       只在「没有可显示内容」时出现，避免已有订单时整卡闪一下 -->
  <view wx:elif="{{homeLoading}}" class="card active-card" aria-hidden="true">
    <view class="row between">
      <view class="sk sk-pill sk-w-tag"></view>
      <view class="sk sk-line sk-w-no"></view>
    </view>
    <view class="sk sk-line sk-gap-lg"></view>
    <view class="sk sk-line short"></view>
    <view class="sk-foot">
      <view class="sk sk-line short sk-grow"></view>
      <view class="sk sk-block sk-w-btn"></view>
    </view>
  </view>
  <view wx:else class="card empty-card">
    <view class="empty-icon">{{reviewMode ? '✓' : '📭'}}</view>
    <view class="strong">{{reviewMode ? '暂时没有进行中的登记' : '暂时没有进行中的订单'}}</view>
    <view wx:if="{{reviewMode}}" class="muted small">有需要时，点击上方入口登记快递信息</view>
  </view>

  <view wx:if="{{reviewMode}}" class="notice-card">
    <view class="notice-icon">i</view>
    <view>
      <view class="strong">取件凭证仅用于本次登记核对</view>
      <view class="muted small">凭证不公开展示，提交后仅工作人员可见</view>
    </view>
  </view>
</view>

<view wx:if="{{showCouponGift && !reviewMode}}" class="gift-mask" catchtouchmove="noop">
  <view class="gift-modal">
    <view class="gift-head">
      <view class="gift-icon"><view class="gift-check">🎁</view></view>
      <view class="gift-kicker">COUPON GIFT</view>
      <view class="gift-title">你收到了新的优惠券</view>
      <view class="gift-subtitle">平台已发放至你的券包，下单时自动抵扣</view>
    </view>
    <view wx:for="{{couponGifts}}" wx:key="id" class="coupon-card">
      <view class="coupon-value"><text>¥</text>{{item.amount}}</view>
      <view class="coupon-divider"></view>
      <view class="coupon-copy">
        <view class="coupon-name">{{item.name}}</view>
        <view class="coupon-rule">{{item.minSpend > 0 ? '满¥' + item.minSpend + '可用' : '无门槛'}} · 下单自动选择</view>
        <view class="coupon-expire">{{item.expireText}}</view>
      </view>
    </view>
    <view class="gift-foot">
      <view class="gift-button" bindtap="dismissCouponGift">收下优惠券</view>
      <view class="gift-tip">可在「我的」→「我的券包」中查看所有优惠券</view>
    </view>
  </view>
</view>
