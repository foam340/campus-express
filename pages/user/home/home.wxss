/* 首页样式 · 暖橙快递站（贴纸票券感）
   ① 奶油底 #FFF7EE（全局令牌），卡片一律墨线描边 + 硬阴影，靠描边分层不靠柔阴影
   ② 主卡 hero：外圈斜条纹 + 内侧深橙圆角框（⟵ 提案定稿样式）
   ③ 状态标签胶囊化、金额/截止时间用深橙强调
   ④ 时间窗胶囊保留原文案（那行勿随手改，见 home.wxml 注释），仅换配色
   说明：这里不再声明整套本地令牌，统一用 styles/variables.wxss 的全局令牌 */

.home-page {
  padding-top: 28rpx;
  background: var(--color-bg);
}

/* ---------- 顶部问候 ---------- */
.top-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  margin-bottom: 26rpx;
}
.top-row > view:first-child { flex: 1; min-width: 0; }

/* 字号统一按预览稿换算（375px 稿：1px = 2rpx），见原型 .home-top h2 / .addr / .edit-link */
.hello {
  font-size: 40rpx;
  font-weight: 900;
  letter-spacing: -2rpx;
  line-height: 1.2;
  color: var(--color-text);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.address {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: var(--color-text-2);
}
/* 「修改」：深橙文字 + 细下划线（原为荧光绿粗下划线） */
.change {
  margin-left: 12rpx;
  color: var(--color-primary-deep);
  font-size: 22rpx;
  font-weight: 800;
  border-bottom: 2rpx solid var(--color-primary);
  padding-bottom: 2rpx;
}
/* 时间窗：暖橙浅底胶囊，文案原样不动 */
.service-pill {
  flex: none;
  padding: 10rpx 18rpx;
  border-radius: 999rpx;
  background: var(--color-primary-soft);
  border: 2rpx solid rgba(255, 107, 44, 0.32);
  color: var(--color-primary-deep);
  font-size: 24rpx;
  font-weight: 800;
  white-space: nowrap;
}

/* ---------- 主卡：外圈斜条纹 + 内侧深橙框 ---------- */
.hero {
  position: relative;
  overflow: hidden;
  margin-top: 26rpx;
  min-height: 330rpx;
  /* 对齐原型 .hero：圆角 26px、内边距 22px 20px 20px */
  padding: 44rpx 40rpx 40rpx;
  border-radius: 52rpx;
  border: var(--border-ink-width) solid var(--color-ink);
  background: repeating-linear-gradient(-45deg, #FF7A3D 0 28rpx, #FF6B2C 28rpx 56rpx);
  color: #ffffff;
  box-shadow: var(--shadow-sticker);
  transition: transform 120ms var(--ease);
}
.hero:active { transform: translateY(4rpx); box-shadow: 0 2rpx 0 rgba(36, 21, 5, 0.9); }
/* 内侧深色圆角框：不透明盖住底下条纹，条纹只露在外圈 */
.hero-copy {
  position: relative;
  z-index: 2;
  width: 100%;
  /* 对齐原型 .hero .inner：内边距 16px、圆角 18px */
  padding: 32rpx;
  border-radius: 36rpx;
  background-color: #E8571A;
  background-image: radial-gradient(rgba(255, 255, 255, 0.12) 2rpx, transparent 2.4rpx);
  background-size: 26rpx 26rpx;
}
/* 右上角纸箱贴纸：原型是 44px（= 88rpx），之前只给了 44rpx，小了一半 */
.hero-box {
  position: absolute;
  right: 28rpx;
  top: 36rpx;
  z-index: 3;
  font-size: 88rpx;
  line-height: 1;
  transform: rotate(8deg);
  filter: drop-shadow(0 8rpx 0 rgba(36, 21, 5, 0.35));
}
.hero-kicker {
  font-size: 20rpx;
  font-weight: 800;
  letter-spacing: 4rpx;
  color: #FFD9A8;
}
/* 对齐原型 .hero h3：32px = 64rpx */
.hero-title {
  margin-top: 12rpx;
  font-size: 64rpx;
  font-weight: 900;
  letter-spacing: -1rpx;
  line-height: 1.15;
}
/* 对齐原型 .hero p：12px = 24rpx */
.hero-sub {
  margin-top: 12rpx;
  font-size: 24rpx;
  line-height: 1.6;
  color: rgba(255, 255, 255, 0.88);
}
/* 行动按钮：白底 + 墨线 + 硬阴影，像贴上去的贴纸 */
.hero-action {
  display: inline-flex;
  align-items: center;
  margin-top: 28rpx;
  padding: 18rpx 36rpx;
  border-radius: 999rpx;
  background: #ffffff;
  color: var(--color-primary-deep);
  border: var(--border-ink-width) solid var(--color-ink);
  box-shadow: 0 6rpx 0 rgba(36, 21, 5, 0.9);
  font-size: 28rpx;
  font-weight: 800;
}
.hero-action text { margin-left: 16rpx; }

/* ---------- 区块标题 ---------- */
.section-head { margin: 46rpx 4rpx 20rpx; }
/* 对齐原型 .sec-head：16px = 32rpx */
.section-head .section-title {
  font-size: 32rpx;
  font-weight: 800;
  letter-spacing: -1rpx;
}
/* 对齐原型 .sec-head .aside：12px = 24rpx */
.all-link {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  color: var(--color-text-2);
  font-size: 24rpx;
  font-weight: 700;
}
.all-link::after {
  content: '↗';
  display: flex;
  align-items: center;
  justify-content: center;
  width: 30rpx;
  height: 30rpx;
  border-radius: 50%;
  background: var(--color-primary-soft);
  color: var(--color-primary-deep);
  font-size: 17rpx;
  line-height: 1;
}

/* ---------- 当前订单卡 ---------- */
.active-card {
  /* 对齐原型 .order-card：内边距 16px = 32rpx */
  padding: 32rpx;
  border: var(--border-ink-width) solid var(--color-ink);
  border-radius: 32rpx;
  background: var(--color-surface);
  box-shadow: var(--shadow-sticker);
}
/* 状态胶囊：所有状态统一暖橙；若要按状态分色（进行中橙 / 已完成绿）需要数据层给 statusType，本轮未动逻辑 */
.active-card .tag-blue {
  color: #ffffff;
  background: var(--color-primary);
  border: 2rpx solid var(--color-ink);
  box-shadow: 0 3rpx 0 rgba(36, 21, 5, 0.9);
  font-size: 22rpx;
}
.order-no {
  max-width: 58%;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
  color: var(--color-hint);
  font-size: 21rpx;
}

.route-row { position: relative; margin-top: 30rpx; padding-left: 36rpx; }
.route-dot { position: absolute; left: 2rpx; width: 16rpx; height: 16rpx; border-radius: 50%; border: 2rpx solid var(--color-ink); }
.route-dot.start { top: 5rpx; background: var(--color-ink); }
.route-dot.end { bottom: 6rpx; background: var(--color-primary); }
.route-line {
  position: absolute;
  left: 9rpx;
  top: 20rpx;
  bottom: 20rpx;
  width: 0;
  border-left: 2rpx dashed var(--color-primary);
}
.route-copy { display: flex; flex-direction: column; gap: 28rpx; font-size: 27rpx; font-weight: 600; }

.deadline-label { color: var(--color-muted); font-size: 22rpx; }
.deadline { margin-top: 6rpx; font-size: 34rpx; font-weight: 800; color: var(--color-primary-deep); }
.detail-btn {
  padding: 16rpx 26rpx;
  border-radius: 20rpx;
  color: var(--color-text);
  background: #ffffff;
  border: 2rpx solid var(--color-ink);
  box-shadow: 0 3rpx 0 rgba(36, 21, 5, 0.9);
  font-size: 24rpx;
  font-weight: 800;
  transition: transform 100ms var(--ease);
}
.detail-btn:active { transform: translateY(3rpx); box-shadow: none; }

/* ---------- 空状态：软圆底 + 纸箱/邮箱贴纸，无虚线框、无动画 ---------- */
.empty-card {
  text-align: center;
  padding: 56rpx 24rpx;
  border: var(--border-ink-width) solid var(--color-ink);
  border-radius: 32rpx;
  background: var(--color-surface);
  box-shadow: var(--shadow-sticker);
}
.empty-icon {
  width: 128rpx;
  height: 128rpx;
  line-height: 128rpx;
  margin: 0 auto 24rpx;
  border-radius: 50%;
  background: var(--color-surface-2);
  font-size: 60rpx;
}
/* ---------- 骨架屏占位尺寸（形状对齐真实订单卡） ---------- */
.sk-w-tag { width: 180rpx; }
.sk-w-no { width: 170rpx; margin-bottom: 0; }
.sk-gap-lg { margin-top: 30rpx; }
.sk-grow { flex: 1; margin: 0 20rpx 0 0; }
.sk-w-btn { width: 176rpx; }
.sk-foot { display: flex; align-items: center; margin-top: 30rpx; }

/* 对齐原型 .empty b：17px = 34rpx */
.empty-card .strong { display: block; font-size: 34rpx; font-weight: 800; }
.empty-card .muted { margin-top: 10rpx; line-height: 1.5; }

/* ---------- 安全提示 ---------- */
.notice-card {
  display: flex;
  align-items: flex-start;
  gap: 20rpx;
  margin-top: 24rpx;
  padding: 26rpx;
  border-radius: 26rpx;
  background: var(--color-surface);
  border: var(--border-ink-width) solid var(--color-ink);
}
.notice-icon {
  flex: none;
  width: 44rpx;
  height: 44rpx;
  line-height: 44rpx;
  text-align: center;
  border-radius: 50%;
  background: var(--color-primary-soft);
  color: var(--color-primary-deep);
  font-weight: 900;
  font-size: 24rpx;
}

/* ---------- 暂停服务 ---------- */
.service-closed-banner {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 22rpx;
  padding: 22rpx 24rpx;
  border-radius: 24rpx;
  background: var(--color-danger-soft);
  border: 2rpx solid var(--color-danger);
}
.service-closed-icon { flex: none; font-size: 30rpx; line-height: 1; }
.service-closed-text {
  flex: 1;
  min-width: 0;
  color: var(--color-danger);
  font-size: 24rpx;
  font-weight: 700;
  line-height: 1.5;
}
.hero-closed { filter: grayscale(0.72); opacity: 0.72; }

/* ---------- 领券弹窗：沿用原结构，改为暖橙票券感 ---------- */
.gift-mask { position: fixed; z-index: 200; left: 0; top: 0; right: 0; bottom: 0; display: flex; align-items: center; justify-content: center; padding: 42rpx; background: rgba(36, 21, 5, 0.52); }
.gift-modal { width: 100%; max-width: 610rpx; max-height: 80vh; overflow-y: auto; padding: 42rpx 36rpx 32rpx; border-radius: 36rpx; background: var(--color-surface); border: var(--border-ink-width) solid var(--color-ink); box-shadow: 0 24rpx 60rpx rgba(36, 21, 5, 0.35); }
.gift-head { text-align: center; }
.gift-icon { display: flex; align-items: center; justify-content: center; width: 94rpx; height: 94rpx; margin: 0 auto 22rpx; border-radius: 30rpx; background: var(--color-primary-soft); }
.gift-check { width: 52rpx; height: 52rpx; line-height: 52rpx; text-align: center; font-size: 30rpx; }
.gift-kicker { color: var(--color-primary-deep); font-size: 18rpx; letter-spacing: 3rpx; font-weight: 800; }
.gift-title { margin-top: 10rpx; color: var(--color-text); font-size: 36rpx; font-weight: 900; }
.gift-subtitle { margin-top: 9rpx; color: var(--color-muted); font-size: 22rpx; }
.gift-modal .coupon-card { position: relative; display: flex; align-items: center; min-height: 140rpx; margin-top: 20rpx; padding: 24rpx; overflow: hidden; border: 2rpx solid var(--color-warning); border-radius: 26rpx; background: var(--color-warning-soft); }
.gift-modal .coupon-card::before,
.gift-modal .coupon-card::after { content: ''; position: absolute; right: 140rpx; width: 22rpx; height: 22rpx; border-radius: 50%; background: var(--color-surface); }
.gift-modal .coupon-card::before { top: -12rpx; }
.gift-modal .coupon-card::after { bottom: -12rpx; }
.gift-modal .coupon-value { flex: none; width: 110rpx; text-align: center; color: var(--color-warning); font-size: 56rpx; line-height: 1; font-weight: 900; }
.gift-modal .coupon-value text { margin-right: 2rpx; font-size: 24rpx; }
.gift-modal .coupon-divider { align-self: stretch; width: 0; margin: 0 20rpx 0 6rpx; border-left: 2rpx dashed var(--color-warning); }
.gift-modal .coupon-copy { flex: 1; min-width: 0; }
.gift-modal .coupon-name { color: var(--color-text); font-size: 25rpx; font-weight: 800; }
.gift-modal .coupon-rule { margin-top: 9rpx; color: var(--color-warm); font-size: 20rpx; }
.gift-foot { margin-top: 28rpx; text-align: center; }
.gift-button { height: 88rpx; line-height: 88rpx; color: var(--color-on-accent); border-radius: 24rpx; background: var(--color-primary); border: var(--border-ink-width) solid var(--color-ink); box-shadow: var(--shadow-sticker); font-size: 29rpx; font-weight: 800; }
.gift-tip { margin-top: 16rpx; color: var(--color-hint); font-size: 19rpx; }

@media (prefers-reduced-motion: reduce) {
  .hero, .hero:active, .detail-btn, .detail-btn:active { transition: none; transform: none; }
}
