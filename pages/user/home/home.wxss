.home-page { padding-top: 28rpx; }
.top-row { display: flex; align-items: center; justify-content: space-between; gap: 20rpx; margin-bottom: 26rpx; }
.top-row>view:first-child { flex: 1; min-width: 0; }
.hello { font-size: 40rpx; font-weight: 800; letter-spacing: -1rpx; }
.address { margin-top: 8rpx; color: var(--color-text-2); font-size: 25rpx; }
.change { margin-left: 10rpx; color: var(--color-primary); }
.service-pill { flex: none; padding: 13rpx 18rpx; color: var(--color-text-2); background: var(--color-surface); border-radius: 20rpx; font-size: 21rpx; box-shadow: 0 6rpx 20rpx var(--shadow-color); }
.hero { position: relative; min-height: 304rpx; padding: 36rpx; overflow: hidden; border-radius: 30rpx; color: var(--color-on-accent); background: linear-gradient(135deg,var(--color-primary),#5b91fb); box-shadow: 0 16rpx 38rpx rgba(47,109,246,.18); }
.hero::after { content:''; position:absolute; width:280rpx; height:280rpx; border:50rpx solid rgba(255,255,255,.08); border-radius:50%; right:-100rpx; top:-120rpx; }
.hero-copy { position: relative; z-index: 2; width: 100%; }
.hero-kicker { font-size: 20rpx; opacity: .72; letter-spacing: 3rpx; }
.hero-title { margin-top: 16rpx; font-size: 52rpx; font-weight: 800; }
.hero-sub { margin-top: 10rpx; font-size: 25rpx; line-height: 1.6; opacity: .86; }
.hero-action { display:inline-flex; align-items:center; margin-top: 28rpx; padding:15rpx 24rpx; border-radius:19rpx; color:var(--color-primary); background:var(--color-surface); font-size:25rpx; font-weight:700; }
.hero-action text { margin-left: 18rpx; }
.section-head { margin: 44rpx 4rpx 20rpx; }
.all-link { color:var(--color-primary); font-size:24rpx; }
.active-card { padding: 28rpx; }
.order-no { max-width:58%; overflow:hidden; white-space:nowrap; text-overflow:ellipsis; color:var(--color-hint); font-size:21rpx; }
.route-row { position:relative; margin-top:30rpx; padding-left:36rpx; }
.route-dot { position:absolute; left:2rpx; width:16rpx; height:16rpx; border-radius:50%; }
.route-dot.start { top:7rpx; background:var(--color-primary); }.route-dot.end { bottom:8rpx; background:#20b486; }
.route-line { position:absolute; left:9rpx; top:20rpx; bottom:20rpx; width:2rpx; background:var(--color-divider); }
.route-copy { display:flex; flex-direction:column; gap:28rpx; font-size:27rpx; font-weight:600; }
.deadline-label { color:var(--color-muted); font-size:22rpx; }.deadline { margin-top:4rpx; font-weight:700; }
.detail-btn { padding:16rpx 24rpx; border-radius:18rpx; color:var(--color-primary); background:var(--color-primary-soft); font-size:24rpx; font-weight:700; }
.empty-card { text-align:center; padding:48rpx 20rpx; }
.empty-icon { width:70rpx; height:70rpx; line-height:70rpx; margin:0 auto 18rpx; border-radius:50%; color:#20b486; background:var(--color-success-soft); font-weight:800; }
.empty-card .muted { margin-top:10rpx; }
.notice-card { display:flex; gap:20rpx; margin-top:24rpx; padding:24rpx; border-radius:24rpx; background:var(--color-primary-soft); }
.notice-icon { flex:none; width:42rpx; height:42rpx; line-height:42rpx; text-align:center; color:var(--color-primary); background:var(--color-surface); border-radius:50%; font-weight:800; }

/* service closed banner */
.service-closed-banner { display:flex; align-items:center; gap:16rpx; margin-bottom:22rpx; padding:22rpx 24rpx; border-radius:20rpx; background:var(--color-danger-soft); border:2rpx solid var(--color-danger-soft); }
.service-closed-icon { flex:none; font-size:30rpx; line-height:1; }
.service-closed-text { flex:1; min-width:0; color:var(--color-danger); font-size:24rpx; font-weight:700; line-height:1.5; }
.hero-closed { filter:grayscale(.75); opacity:.72; }

/* coupon gift modal — reused from welcome page design */
.gift-mask { position:fixed; z-index:200; left:0; top:0; right:0; bottom:0; display:flex; align-items:center; justify-content:center; padding:42rpx; background:rgba(23,34,51,.52); }
.gift-modal { width:100%; max-width:610rpx; max-height:80vh; overflow-y:auto; padding:42rpx 36rpx 32rpx; border-radius:36rpx; background:var(--color-surface); box-shadow:0 30rpx 80rpx var(--shadow-color); }
.gift-head { text-align:center; }
.gift-icon { display:flex; align-items:center; justify-content:center; width:94rpx; height:94rpx; margin:0 auto 22rpx; border-radius:30rpx; background:linear-gradient(145deg,var(--color-warning-soft),var(--color-warning-soft)); }
.gift-check { width:52rpx; height:52rpx; line-height:52rpx; text-align:center; font-size:30rpx; }
.gift-kicker { color:var(--color-warning); font-size:18rpx; letter-spacing:3rpx; font-weight:800; }
.gift-title { margin-top:10rpx; color:var(--color-text); font-size:36rpx; font-weight:900; }
.gift-subtitle { margin-top:9rpx; color:var(--color-muted); font-size:22rpx; }
.gift-modal .coupon-card { position:relative; display:flex; align-items:center; min-height:140rpx; margin-top:20rpx; padding:24rpx; overflow:hidden; border:2rpx solid var(--color-warning-soft); border-radius:26rpx; background:linear-gradient(135deg,var(--color-warning-soft),var(--color-warning-soft)); }
.gift-modal .coupon-card::before,.gift-modal .coupon-card::after { content:''; position:absolute; right:140rpx; width:22rpx; height:22rpx; border-radius:50%; background:var(--color-surface); }.gift-modal .coupon-card::before { top:-12rpx; }.gift-modal .coupon-card::after { bottom:-12rpx; }
.gift-modal .coupon-value { flex:none; width:110rpx; text-align:center; color:var(--color-warning); font-size:56rpx; line-height:1; font-weight:900; }.gift-modal .coupon-value text { margin-right:2rpx; font-size:24rpx; }
.gift-modal .coupon-divider { align-self:stretch; width:1rpx; margin:0 20rpx 0 6rpx; border-left:2rpx dashed #e0c8a0; }
.gift-modal .coupon-copy { flex:1; min-width:0; }.gift-modal .coupon-name { color:var(--color-text); font-size:25rpx; font-weight:800; }.gift-modal .coupon-rule { margin-top:9rpx; color:var(--color-warm); font-size:20rpx; }
.gift-foot { margin-top:28rpx; text-align:center; }
.gift-button { height:88rpx; line-height:88rpx; color: var(--color-on-accent); border-radius:24rpx; background:var(--color-warning); box-shadow:0 12rpx 28rpx rgba(239,124,44,.22); font-size:29rpx; font-weight:800; }
.gift-tip { margin-top:16rpx; color:var(--color-hint); font-size:19rpx; }
