:host { display: block; }
.tabbar-safe {
  position: fixed;
  z-index: 100;
  left: 24rpx;
  right: 24rpx;
  bottom: calc(12rpx + env(safe-area-inset-bottom));
  height: 104rpx;
  /* tabBar 渲染在 page 之外，page{} 的变量到不了这里；动效 token 不随主题变，就地声明 */
  --ease: cubic-bezier(0.32, 0.72, 0, 1);
  --ease-bounce: cubic-bezier(0.34, 1.56, 0.64, 1);
}
.tabbar-main {
  position: relative;
  display: flex;
  align-items: stretch;
  width: 100%;
  height: 104rpx;
  overflow: hidden;
  border: 1rpx solid var(--color-divider);
  border-radius: 52rpx;
  background: var(--color-tabbar);
  -webkit-backdrop-filter: saturate(160%) blur(14px);
  backdrop-filter: saturate(160%) blur(14px);
  box-shadow: 0 12rpx 34rpx var(--shadow-color);
  box-sizing: border-box;
}
.tab-item {
  position: relative;
  z-index: 1;
  display: flex;
  flex: 1;
  min-width: 0;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: var(--color-muted);
  font-size: 22rpx;
  transition: color 160ms var(--ease), transform 100ms var(--ease);
}
.tab-item:active { transform: scale(0.97); }
.tab-indicator {
  position: absolute;
  left: 0;
  top: 0;
  width: 33.3333%;
  height: 100%;
  padding: 7rpx;
  pointer-events: none;
  transition: transform 130ms cubic-bezier(0.42, 0, 0.58, 1);
  will-change: transform;
  z-index: 0;
  box-sizing: border-box;
}
.tab-indicator.instant { transition: none; }
.tab-indicator-pill {
  width: 100%;
  height: 100%;
  border-radius: 45rpx;
  background: var(--color-tabbar-indicator);
}
.tab-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 42rpx;
  height: 42rpx;
  margin-bottom: 2rpx;
}
.tab-icon-image {
  display: block;
  width: 29rpx;
  height: 29rpx;
  transition: filter 160ms var(--ease), transform 160ms var(--ease), opacity 160ms var(--ease);
}
.tab-label { display: block; height: 28rpx; line-height: 28rpx; }
.tab-item.active { color: var(--color-primary); font-weight: 700; }
.tab-item.active .tab-icon-image {
  filter: brightness(0) saturate(100%) invert(39%) sepia(97%) saturate(3276%) hue-rotate(200deg) brightness(101%) contrast(106%);
  animation: tab-icon-settle 180ms var(--ease) both;
}
@keyframes tab-icon-settle {
  from { transform: scale(0.88); opacity: 0.65; }
  to { transform: scale(1); opacity: 1; }
}
@media (prefers-reduced-motion: reduce) {
  /* Retain this short, local wayfinding motion; suppress only decoration. */
  .tab-item, .tab-icon-image { transition: none; }
  .tab-item.active .tab-icon-image { animation: none; }
}
@media (prefers-reduced-transparency: reduce) {
  .tabbar-main {
    background: var(--color-surface);
    -webkit-backdrop-filter: none;
    backdrop-filter: none;
  }
}
