<view wx:if="{{variant === 'user'}}" class="card user-card" bindtap="handleOpen">
  <view class="row between">
    <view class="tag status-{{statusType}}">{{order.statusText}}</view>
    <view class="muted small">{{order.createdAt}}</view>
  </view>
  <view class="order-main">
    <view class="parcel-mini"><view class="parcel-ribbon"></view></view>
    <view class="order-copy"><view class="strong">{{order.pieces}}件快递</view><view class="muted small">{{order.urgencyText}}送达 · {{order.building}}{{order.room}}</view></view>
    <view wx:if="{{!reviewMode}}" class="price"><view class="price-value">¥{{order.paidAmount}}</view><text wx:if="{{order.discountAmount>0}}" class="discount-value">已优惠¥{{order.discountAmount}}</text></view>
  </view>
  <view class="order-foot row between"><text class="muted small order-id">{{order.id}}</text><text class="open">查看详情 〉</text></view>
</view>

<view wx:elif="{{variant === 'hall'}}" class="card hall-card {{order.blocked ? 'hall-blocked' : ''}}">
  <view class="row between top-line">
    <view class="row tag-line"><view wx:if="{{order.urgency !== 'tomorrow'}}" class="tag {{order.urgency==='urgent'?'orange':'blue'}}">{{order.urgencyText}}</view><view wx:if="{{order.campus !== 'shipai' && order.pickupScopeText}}" class="tag {{order.pickupScope==='mixed'?'orange':(order.pickupScope==='off_campus'?'red':'green')}}">{{order.pickupScopeText}}</view><view wx:if="{{order.campus === 'shipai' && order.pickupStationText}}" class="tag tag-green">{{order.pickupStationText}}</view><view wx:if="{{order.buildingGenderText}}" class="tag {{order.buildingGender==='female'?'red':(order.buildingGender==='mixed'?'orange':'blue')}}">{{order.buildingGenderText}}</view><view class="tag {{order.noUpstairs ? 'purple' : 'gray'}}">{{order.noUpstairs ? '不送上楼' : '送上楼'}}</view></view>
    <view class="deadline">{{order.deadline}}</view>
  </view>
  <view class="hall-info"><view class="destination"><text class="destination-label">送至</text>{{order.building}}</view><view class="meta">{{sizeSummary}}</view></view>
  <view wx:if="{{order.blocked}}" class="block-reason">{{order.blockReason}}</view>
  <view class="privacy"><view class="privacy-lock">锁</view><text class="privacy-copy">截图、门牌号和手机号接单后解锁</text></view>
  <view class="divider"></view>
  <view class="row between"><view wx:if="{{!reviewMode}}"><text class="income-label">本单收入</text><text class="income">¥{{order.price}}</text></view><view wx:else></view><button class="grab {{order.blocked || taskCount>=maxTaskCount ? 'disabled' : ''}}" catchtap="handleGrab">{{order.blocked ? '不可接' : (taskCount>=maxTaskCount?'已达上限':'立即抢单')}}</button></view>
</view>

<view wx:else class="card task-card" bindtap="handleOpen">
  <view class="side-bar {{order.urgency==='urgent'?'urgent-bar':''}}"></view>
  <view class="row between top-line"><view class="row tag-line"><view class="tag {{order.status==='delivered'?'green':order.urgency==='urgent'?'orange':'blue'}}">{{order.statusText}}</view><view wx:if="{{order.campus !== 'shipai' && order.pickupScopeText}}" class="tag {{order.pickupScope==='mixed'?'orange':(order.pickupScope==='off_campus'?'red':'green')}}">{{order.pickupScopeText}}</view><view wx:if="{{order.campus === 'shipai' && order.pickupStationText}}" class="tag tag-green">{{order.pickupStationText}}</view><view wx:if="{{order.buildingGenderText}}" class="tag {{order.buildingGender==='female'?'red':(order.buildingGender==='mixed'?'orange':'blue')}}">{{order.buildingGenderText}}</view><view class="tag {{order.noUpstairs ? 'purple' : 'gray'}}">{{order.noUpstairs ? '不送上楼' : '送上楼'}}</view></view><view class="deadline muted">{{order.deadline}}</view></view>
  <view class="task-main row between"><view class="task-copy"><view class="task-dest">{{order.building}}{{order.room}}</view><view class="muted small">{{order.pieces}}件{{order.isLarge?' · 大件':''}}</view></view><view class="open">{{order.status==='accepted'?'去取件':order.status==='picked'?'开始配送':order.status==='delivering'?'去送达':'等待确认'}} 〉</view></view>
</view>
