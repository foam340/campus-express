:host { display:block; width:100%; }
/* 卡片统一走贴纸感：墨线描边 + 硬阴影 */
.card { width:100%; padding:26rpx; border:var(--border-ink-width) solid var(--color-ink); border-radius:30rpx; background:var(--color-surface); box-shadow:var(--shadow-sticker); box-sizing:border-box; }
.row { display:flex; align-items:center; min-width:0; }.between { justify-content:space-between; }.strong { font-weight:700; }.small { font-size:23rpx; }.muted { color:var(--color-muted); }
/* 状态标签胶囊：加一圈细描边，像贴在卡片上的小贴纸 */
.tag { display:inline-flex; align-items:center; height:44rpx; padding:0 16rpx; border:2rpx solid rgba(36,21,5,.22); border-radius:22rpx; font-size:21rpx; font-weight:700; }.blue { color:#ffffff; background:var(--color-primary); border-color:var(--color-ink); }.orange { color:var(--color-warning); background:var(--color-warning-soft); }.green { color:var(--color-success); background:var(--color-success-soft); }.red { color:var(--color-danger); background:var(--color-danger-soft); }.purple { color:var(--color-purple); background:var(--color-purple-soft); }.gray { color:var(--color-text-2); background:var(--color-gray-soft); }
/* 主状态标签按「进行中 / 已完成 / 待支付 / 已取消 / 客服处理中」分色 */
.tag.status-running { color:#ffffff; background:var(--color-primary); border-color:var(--color-ink); }
.tag.status-done { color:var(--color-success); background:var(--color-success-soft); }
.tag.status-pending { color:var(--color-purple); background:var(--color-purple-soft); }
.tag.status-off { color:var(--color-text-2); background:var(--color-gray-soft); }
.tag.status-alert { color:var(--color-danger); background:var(--color-danger-soft); }
.order-main { display:flex; align-items:center; padding:27rpx 0; }.parcel-mini { position:relative; flex:none; width:74rpx; height:74rpx; border-radius:20rpx; background:var(--color-primary-soft); border:2rpx solid var(--color-ink); }.parcel-mini::before { content:''; position:absolute; width:42rpx; height:34rpx; left:16rpx; top:24rpx; border-radius:5rpx; background:#E09A5C; }.parcel-ribbon { position:absolute; z-index:1; width:9rpx; height:34rpx; left:33rpx; top:24rpx; background:#FFD9A8; }.order-copy { flex:1; min-width:0; margin-left:18rpx; }.order-copy .muted { margin-top:7rpx; }.price { flex:none; margin-left:14rpx; font-size:31rpx; font-weight:800; }.order-foot { padding-top:18rpx; border-top:2rpx dashed var(--color-divider); }.order-id { flex:1; min-width:0; margin-right:16rpx; overflow:hidden; white-space:nowrap; text-overflow:ellipsis; }.open { flex:none; color:var(--color-primary-deep); font-size:23rpx; font-weight:700; }
.top-line { gap:16rpx; }.tag-line { flex:1; flex-wrap:wrap; gap:9rpx; }.deadline { flex:none; font-size:22rpx; }.hall-card .deadline { color:var(--color-primary-deep); font-weight:700; }.hall-info { padding:28rpx 0 20rpx; }.destination { font-size:35rpx; font-weight:800; }.destination-label { margin-right:13rpx; color:var(--color-muted); font-size:21rpx; font-weight:400; }.meta { margin-top:10rpx; color:var(--color-text-2); font-size:24rpx; }.privacy { display:flex; align-items:center; padding:15rpx; border-radius:15rpx; color:var(--color-text-2); background:var(--color-surface-2); border:2rpx solid var(--color-divider); font-size:21rpx; }.privacy-lock { display:flex; flex:none; align-items:center; justify-content:center; width:36rpx; height:36rpx; margin-right:11rpx; border-radius:10rpx; color:var(--color-primary-deep); background:var(--color-primary-soft); font-size:18rpx; font-weight:800; }.privacy-copy { flex:1; min-width:0; }.divider { height:0; margin:24rpx 0; border-top:2rpx dashed var(--color-divider); }.income-label { color:var(--color-muted); font-size:21rpx; }.income { margin-left:9rpx; color:var(--color-primary-deep); font-size:37rpx; font-weight:800; }.grab { display:flex; flex:none; align-items:center; justify-content:center; width:208rpx; height:74rpx; margin:0; border:var(--border-ink-width) solid var(--color-ink); border-radius:20rpx; color:var(--color-on-accent); background:var(--color-primary); box-shadow:0 4rpx 0 rgba(36,21,5,.9); font-size:25rpx; font-weight:700; }.grab::after { border:0; }.grab.disabled { color:var(--color-hint); background:var(--color-surface-2); box-shadow:none; }
.task-card { position:relative; overflow:hidden; padding-left:34rpx; }.side-bar { position:absolute; left:0; top:0; bottom:0; width:10rpx; background:var(--color-primary); }.urgent-bar { background:var(--color-warning); }.task-main { gap:18rpx; margin-top:27rpx; }.task-copy { flex:1; min-width:0; }.task-dest { margin-bottom:8rpx; font-size:34rpx; font-weight:800; }

.user-card .price { text-align:right; }
.user-card .price-value { font-size:31rpx; font-weight:800; }
.user-card .discount-value { display:block; margin-top:4rpx; color:var(--color-primary-deep); font-size:18rpx; font-weight:500; }

.hall-card.hall-blocked { opacity:0.6; }
.block-reason { margin-bottom:14rpx; padding:12rpx 16rpx; border-radius:12rpx; border:2rpx solid var(--color-warning-soft); color:var(--color-warning); background:var(--color-warning-soft); font-size:22rpx; line-height:32rpx; }
