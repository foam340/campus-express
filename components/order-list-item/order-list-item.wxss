:host { display:block; width:100%; }
.card { width:100%; padding:26rpx; border-radius:24rpx; background:var(--color-surface); box-shadow:0 10rpx 30rpx var(--shadow-color); box-sizing:border-box; }
.row { display:flex; align-items:center; min-width:0; }.between { justify-content:space-between; }.strong { font-weight:700; }.small { font-size:23rpx; }.muted { color:var(--color-muted); }
.tag { display:inline-flex; align-items:center; height:44rpx; padding:0 16rpx; border-radius:22rpx; font-size:21rpx; font-weight:700; }.blue { color:var(--color-primary); background:var(--color-primary-soft); }.orange { color:var(--color-warning); background:var(--color-warning-soft); }.green { color:var(--color-success); background:var(--color-success-soft); }.red { color:var(--color-danger); background:var(--color-danger-soft); }.purple { color:var(--color-purple); background:var(--color-purple-soft); }.gray { color:var(--color-text-2); background:var(--color-gray-soft); }
.order-main { display:flex; align-items:center; padding:27rpx 0; }.parcel-mini { position:relative; flex:none; width:74rpx; height:74rpx; border-radius:20rpx; background:var(--color-primary-soft); }.parcel-mini::before { content:''; position:absolute; width:42rpx; height:34rpx; left:16rpx; top:24rpx; border-radius:5rpx; background:#5b91fb; }.parcel-ribbon { position:absolute; z-index:1; width:9rpx; height:34rpx; left:33rpx; top:24rpx; background:#9cbcff; }.order-copy { flex:1; min-width:0; margin-left:18rpx; }.order-copy .muted { margin-top:7rpx; }.price { flex:none; margin-left:14rpx; font-size:31rpx; font-weight:800; }.order-foot { padding-top:18rpx; border-top:1rpx solid var(--color-divider); }.order-id { flex:1; min-width:0; margin-right:16rpx; overflow:hidden; white-space:nowrap; text-overflow:ellipsis; }.open { flex:none; color:var(--color-primary); font-size:23rpx; font-weight:700; }
.top-line { gap:16rpx; }.tag-line { flex:1; flex-wrap:wrap; gap:9rpx; }.deadline { flex:none; font-size:22rpx; }.hall-card .deadline { color:#df722d; font-weight:700; }.hall-info { padding:28rpx 0 20rpx; }.destination { font-size:35rpx; font-weight:800; }.destination-label { margin-right:13rpx; color:var(--color-muted); font-size:21rpx; font-weight:400; }.meta { margin-top:10rpx; color:var(--color-text-2); font-size:24rpx; }.privacy { display:flex; align-items:center; padding:15rpx; border-radius:15rpx; color:var(--color-text-2); background:var(--color-surface-2); font-size:21rpx; }.privacy-lock { display:flex; flex:none; align-items:center; justify-content:center; width:36rpx; height:36rpx; margin-right:11rpx; border-radius:10rpx; color:var(--color-primary); background:var(--color-primary-soft); font-size:18rpx; font-weight:800; }.privacy-copy { flex:1; min-width:0; }.divider { height:1rpx; margin:24rpx 0; background:var(--color-divider); }.income-label { color:var(--color-muted); font-size:21rpx; }.income { margin-left:9rpx; color:var(--color-primary); font-size:37rpx; font-weight:800; }.grab { display:flex; flex:none; align-items:center; justify-content:center; width:208rpx; height:74rpx; margin:0; border-radius:20rpx; color: var(--color-on-accent); background:var(--color-primary); font-size:25rpx; font-weight:700; }.grab::after { border:0; }.grab.disabled { color:var(--color-hint); background:var(--color-surface-2); }
.task-card { position:relative; overflow:hidden; padding-left:34rpx; }.side-bar { position:absolute; left:0; top:0; bottom:0; width:8rpx; background:var(--color-primary); }.urgent-bar { background:var(--color-warning); }.task-main { gap:18rpx; margin-top:27rpx; }.task-copy { flex:1; min-width:0; }.task-dest { margin-bottom:8rpx; font-size:34rpx; font-weight:800; }

.user-card .price { text-align:right; }
.user-card .price-value { font-size:31rpx; font-weight:800; }
.user-card .discount-value { display:block; margin-top:4rpx; color:#ef6f36; font-size:18rpx; font-weight:500; }

.hall-card.hall-blocked { opacity:0.6; }
.block-reason { margin-bottom:14rpx; padding:12rpx 16rpx; border-radius:12rpx; color:var(--color-warning); background:var(--color-warning-soft); font-size:22rpx; line-height:32rpx; }
