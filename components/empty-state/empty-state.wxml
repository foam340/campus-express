<view class="empty-state">
  <view class="empty-icon {{tone}}">{{icon}}</view>
  <view class="empty-title">{{title}}</view>
  <view wx:if="{{description}}" class="empty-description">{{description}}</view>
  <button wx:if="{{actionText}}" class="empty-action" bindtap="handleAction">{{actionText}}</button>
</view>
