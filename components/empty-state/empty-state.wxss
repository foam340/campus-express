.empty-state { padding: 110rpx 24rpx 50rpx; text-align: center; }
.empty-icon { display:flex; align-items:center; justify-content:center; width:84rpx; height:84rpx; margin:0 auto 20rpx; border-radius:27rpx; color:var(--color-primary); background:var(--color-primary-soft); font-weight:800; }
.empty-icon.green { color:var(--color-success); background:var(--color-success-soft); }
.empty-icon.orange { color:var(--color-warning); background:var(--color-warning-soft); }
.empty-title { color:var(--color-text); font-weight:700; }
.empty-description { margin-top:10rpx; color:var(--color-muted); font-size:24rpx; }
.empty-action { display:flex; align-items:center; justify-content:center; width:260rpx; height:80rpx; margin:30rpx auto 0; border:0; border-radius:22rpx; color:var(--color-primary); background:var(--color-primary-soft); font-size:26rpx; font-weight:700; }
.empty-action::after { border:0; }
