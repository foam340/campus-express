/* 空态 · 暖橙快递站：图标改成软圆底（无框），与首页空态保持一致 */
.empty-state { padding:110rpx 24rpx 50rpx; text-align:center; }
.empty-icon { display:flex; align-items:center; justify-content:center; width:96rpx; height:96rpx; margin:0 auto 20rpx; border-radius:50%; color:var(--color-primary-deep); background:var(--color-primary-soft); font-weight:800; font-size:30rpx; }
.empty-icon.green { color:var(--color-success); background:var(--color-success-soft); }
.empty-icon.orange { color:var(--color-warning); background:var(--color-warning-soft); }
.empty-title { color:var(--color-text); font-weight:700; }
.empty-description { margin-top:10rpx; color:var(--color-muted); font-size:24rpx; }
.empty-action { display:flex; align-items:center; justify-content:center; width:260rpx; height:80rpx; margin:30rpx auto 0; border:var(--border-ink-width) solid var(--color-ink); border-radius:22rpx; color:var(--color-primary-deep); background:#ffffff; box-shadow:var(--shadow-sticker); font-size:26rpx; font-weight:700; }
.empty-action::after { border:0; }
