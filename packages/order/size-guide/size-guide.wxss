.size-guide-page {
  min-height:100vh;
  width:100%;
  padding:24rpx 24rpx calc(48rpx + env(safe-area-inset-bottom));
  background:var(--color-bg);
}
.guide-card {
  display:flex;
  align-items:center;
  gap:18rpx;
  padding:24rpx;
  border-radius:22rpx;
  background:var(--color-primary-soft);
}
.guide-mark {
  display:flex;
  flex:none;
  align-items:center;
  justify-content:center;
  width:52rpx;
  height:52rpx;
  border-radius:16rpx;
  color:var(--color-on-accent);
  background:var(--color-primary);
  font-size:28rpx;
  font-weight:850;
}
.guide-copy { flex:1; min-width:0; }
.guide-copy view { color:var(--color-text); font-size:25rpx; font-weight:800; }
.guide-copy text { display:block; margin-top:6rpx; color:var(--color-text-2); font-size:21rpx; line-height:1.5; }
.image-card {
  width:100%;
  margin-top:24rpx;
  overflow:hidden;
  border-radius:24rpx;
  background:var(--color-surface);
  box-shadow:0 10rpx 30rpx var(--shadow-color);
}
.guide-image { display:block; width:100%; height:auto; }
.preview-tip { margin-top:14rpx; color:var(--color-muted); font-size:21rpx; text-align:center; }
