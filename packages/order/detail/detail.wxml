<page-meta page-style="{{pageMetaStyle}}" background-color="{{pageBackgroundColor}}" root-background-color="{{pageBackgroundColor}}" />
<network-banner />
<view wx:if="{{order}}" class="page detail-page">
  <view class="status-hero {{order.status==='completed'?'done-hero':order.status==='disputed'?'danger-hero':''}}">
    <view class="status-kicker">{{reviewMode ? '登记状态' : '订单状态'}}</view>
    <view class="status-title">{{reviewMode && order.status==='unpaid' ? '已登记' : order.statusText}}</view>
    <view class="status-sub">{{reviewMode && order.status==='unpaid' ? '登记已提交，请等待工作人员处理' : (order.status==='unpaid'?'支付处理中，请稍候…':order.status==='waiting'?'订单已进入接单大厅':order.status==='delivered'?'等待用户确认收货':order.status==='completed'?(order.observationHours+'小时内可申请理赔'):(reviewMode ? order.deadline : (order.deliveryDeadline || order.deadline))+' 前送达')}}</view>
    <view wx:if="{{order.afterSale}}" class="after-pill">{{order.afterSale}}{{order.exceptionText?' · '+order.exceptionText:''}}</view>
    <view wx:if="{{observationText && !reviewMode}}" class="after-pill">{{observationText}}</view>
    <view wx:if="{{order.refundStatusText && !reviewMode}}" class="after-pill">{{order.refundStatusText}}{{order.refundAmount?' · ¥'+order.refundAmount:''}}</view>
  </view>

  <view class="card progress-card">
    <view class="section-title">{{reviewMode ? '办理进度' : '配送进度'}}</view>
    <view class="steps">
      <view class="step {{step>=0?'on':''}}"><view class="step-dot">1</view><text>{{reviewMode ? '提交登记' : '订单提交'}}</text></view>
      <view class="step-line {{step>=1?'on':''}}"></view>
      <view class="step {{step>=1?'on':''}}"><view class="step-dot">2</view><text>{{reviewMode ? '已受理' : '已安排配送'}}</text></view>
      <view class="step-line {{step>=2?'on':''}}"></view>
      <view class="step {{step>=2?'on':''}}"><view class="step-dot">3</view><text>已取件</text></view>
      <view class="step-line {{step>=3?'on':''}}"></view>
      <view class="step {{step>=3?'on':''}}"><view class="step-dot">4</view><text>{{reviewMode ? '办理中' : '配送中'}}</text></view>
      <view class="step-line {{step>=4?'on':''}}"></view>
      <view class="step {{step>=4?'on':''}}"><view class="step-dot">5</view><text>{{reviewMode ? '已完成' : '已送达'}}</text></view>
    </view>
  </view>

  <view class="card info-card">
    <view class="row between"><view class="section-title">{{reviewMode ? '登记信息' : '订单信息'}}</view><view class="tag {{order.urgency==='urgent'?'tag-orange':'tag-blue'}}">{{order.urgencyText}}</view></view>
    <!-- 骑手接单后仍要能看到大厅里的性别/送上楼标签。配色与 components/order-list-item 的 hall 分支逐一对齐：
         性别 female=红 / mixed=橙 / male=蓝；不送上楼=紫 / 送上楼=灰。改这里请同步改那边 -->
    <view class="tag-line">
      <view wx:if="{{order.buildingGenderText}}" class="tag {{order.buildingGender==='female'?'tag-red':(order.buildingGender==='mixed'?'tag-orange':'tag-blue')}}">{{order.buildingGenderText}}</view>
      <view class="tag {{order.noUpstairs?'tag-purple':'tag-gray'}}">{{order.noUpstairs?'不送上楼':'送上楼'}}</view>
    </view>
    <view class="info-row"><text>快递信息</text><text>{{order.pieces}}件</text></view>
    <block wx:if="{{order.pricingModel==='itemized_v1' && order.items.length}}">
      <view wx:for="{{order.items}}" wx:key="index" class="item-detail-row">
        <text>快递 {{item.index}}</text>
        <text>{{item.scopeLabel || item.scopeText}} · {{item.sizeText}}<text wx:if="{{role==='user' && !reviewMode}}"> · ¥{{item.unitPrice}}</text></text>
      </view>
    </block>
    <view wx:else class="info-row"><text>大件</text><text>{{order.isLarge?(reviewMode?'是':'是（已含大件附加费）'):'否'}}</text></view>
    <view class="info-row"><text>{{reviewMode ? '完成时限' : '送达时限'}}</text><text>{{reviewMode ? order.deadline : (order.deliveryDeadline || order.deadline)}}</text></view>
    <view class="info-row"><text>{{order.campus === 'shipai' ? '取件驿站' : '取件地点'}}</text><text>{{order.campus === 'shipai' ? (order.pickupStationText || '—') : (order.pickupScopeText || '—')}}</text></view>
    <block wx:if="{{role==='user' && !reviewMode}}">
      <block wx:if="{{order.pricingModel==='itemized_v1'}}">
        <view class="info-row"><text>快递小计</text><text>¥{{order.itemSubtotal}}</text></view>
        <view wx:if="{{order.bundleDiscount>0}}" class="info-row"><text>多件满减</text><text class="discount-price">-¥{{order.bundleDiscount}}</text></view>
        <view wx:if="{{order.urgencyFee>0}}" class="info-row"><text>{{order.urgency==='soon'?'稍急服务':'很急服务'}}</text><text>+¥{{order.urgencyFee}}</text></view>
        <view wx:if="{{order.doorFee>0}}" class="info-row"><text>送到宿舍门口</text><text>+¥{{order.doorFee}}</text></view>
        <view wx:if="{{order.buildingFee>0}}" class="info-row"><text>9栋距离附加费</text><text>+¥{{order.buildingFee}}</text></view>
      </block>
      <view class="info-row"><text>订单原价</text><text>¥{{order.originalPrice}}</text></view>
      <view wx:if="{{order.discountAmount>0}}" class="info-row"><text>{{order.couponName || '优惠券'}}</text><text class="discount-price">-¥{{order.discountAmount}}</text></view>
      <view class="info-row"><text>实付金额</text><text class="price">¥{{order.paidAmount}}</text></view>
    </block>
    <block wx:elif="{{role==='rider' && !reviewMode}}">
      <view class="info-row"><text>本单收入</text><text class="price">¥{{order.price}}</text></view>
      <view wx:if="{{order.discountAmount>0}}" class="income-tip">用户使用了平台优惠，骑手收入不受影响</view>
    </block>
    <view class="info-row"><text>{{reviewMode ? '登记编号' : '订单编号'}}</text><text>{{order.id}}</text></view>
  </view>

  <view wx:if="{{sensitiveVisible}}" class="card screenshot-card">
    <view class="section-title">取件截图</view>
    <view wx:if="{{order.screenshots.length}}" class="shot-grid"><safe-image wx:for="{{order.screenshots}}" wx:key="*this" class="shot-image" src="{{item}}" data-src="{{item}}" mode="aspectFill" bind:tap="previewScreenshot" /></view>
    <view wx:elif="{{imageLoading && pendingScreenshotCount > 0}}" class="image-loading"><text>图片加载中…</text></view>
    <view wx:elif="{{reviewMode}}" class="mock-shot"><view class="mock-code">工作人员受理后查看取件凭证</view><view class="muted small">取件码仅用于本次取件，不公开展示</view></view>
    <view wx:if="{{!reviewMode && failedScreenshotCount > 0}}" class="image-error">
      <text>{{failedScreenshotCount}}张取件截图加载失败，请检查网络后重试</text>
      <button class="image-retry" loading="{{retryingImages}}" disabled="{{imageLoading || retryingImages}}" bindtap="retryImages">{{retryingImages ? '正在重新加载' : '重新加载'}}</button>
    </view>
    <view wx:if="{{role==='rider'}}" class="unlocked">已接单，敏感信息已解锁 · 完成{{order.observationHours}}小时后隐藏</view>
  </view>

  <view wx:if="{{order.deliveryImages.length || (imageLoading && pendingDeliveryCount > 0) || (!reviewMode && sensitiveVisible && failedDeliveryCount > 0)}}" class="card screenshot-card">
    <view class="section-title">送达截图</view>
    <view wx:if="{{order.deliveryImages.length}}" class="shot-grid"><safe-image wx:for="{{order.deliveryImages}}" wx:key="*this" class="shot-image" src="{{item}}" data-src="{{item}}" mode="aspectFill" bind:tap="previewDeliveryImage" /></view>
    <view wx:elif="{{imageLoading && pendingDeliveryCount > 0}}" class="image-loading"><text>图片加载中…</text></view>
    <view wx:if="{{!reviewMode && sensitiveVisible && failedDeliveryCount > 0}}" class="image-error">
      <text>{{failedDeliveryCount}}张送达截图加载失败，请检查网络后重试</text>
      <button class="image-retry" loading="{{retryingImages}}" disabled="{{imageLoading || retryingImages}}" bindtap="retryImages">{{retryingImages ? '正在重新加载' : '重新加载'}}</button>
    </view>
  </view>

  <view wx:if="{{sensitiveVisible && (role==='rider' || order.accepted)}}" class="card contact-card">
    <view class="section-title">{{role==='rider'?'送达信息':'骑手信息'}}</view>
    <view wx:if="{{role==='rider'}}" class="contact-main"><view class="contact-avatar">{{contactInitial}}</view><view><view class="strong">{{order.contactName}} · {{order.building}}{{order.room}}</view><view class="muted small">{{order.phone}}</view></view></view>
    <view wx:else class="contact-main"><view class="contact-avatar rider-avatar">骑</view><view><view class="strong">{{order.riderName || '骑手已接单'}}</view><view class="muted small">{{order.riderPhone}}</view></view></view>
    <view class="secondary-btn call-btn" bindtap="callUser">{{role==='rider'?'打电话给用户':'联系骑手'}}</view>
    <view wx:if="{{role==='rider'}}" class="secondary-btn call-btn sms-btn" bindtap="copyPhone">发短信给用户</view>
    <view wx:if="{{order.note}}" class="note-box">备注：{{order.note}}</view>
  </view>

  <view wx:if="{{!sensitiveVisible}}" class="card hidden-card">
    <view class="hidden-icon"><image src="/assets/icons/ui-lock.png" /></view><view><view class="strong">敏感信息已隐藏</view><view class="muted small">订单完成超过{{order.observationHours}}小时，取件截图、手机号和门牌号已对骑手隐藏。</view></view>
  </view>

  <view wx:if="{{role==='rider' && order.status==='delivering'}}" class="card delivery-card">
    <view class="section-title">送达凭证</view>
    <view class="shot-grid">
      <safe-image wx:for="{{deliveryImages}}" wx:key="*this" class="shot-image" src="{{item}}" mode="aspectFill" />
      <safe-image wx:for="{{pendingDeliveryImages}}" wx:key="*this" class="shot-image" src="{{item}}" mode="aspectFill" />
      <view wx:if="{{deliveryImages.length + pendingDeliveryImages.length < 3}}" class="add-shot" bindtap="chooseDeliveryImage">＋<text>拍照上传</text></view>
    </view>
    <view class="muted small delivery-tip">请拍摄快递和门口位置，不要拍摄用户本人或宿舍内部。</view>
  </view>

  <view class="action-area">
    <block wx:if="{{role==='user'}}">
      <view wx:if="{{order.status==='unpaid' && !reviewMode}}" class="pay-actions">
        <view class="primary-btn" bindtap="retryPayment">去支付</view>
        <view class="text-action danger-text" bindtap="cancelWaiting">取消订单</view>
      </view>
      <view wx:elif="{{order.status==='unpaid' && reviewMode}}" class="secondary-btn" bindtap="cancelWaiting">取消登记</view>
      <view wx:elif="{{order.status==='waiting'}}" class="danger-btn" bindtap="cancelWaiting">取消订单</view>
      <view wx:elif="{{order.status==='delivered'}}" class="primary-btn" bindtap="confirmReceipt">确认收货</view>
      <view wx:elif="{{order.status==='disputed'}}" class="secondary-btn" bindtap="service">查看客服联系方式</view>
      <view wx:elif="{{order.status==='completed'}}" class="secondary-btn" bindtap="service">24小时内申请理赔</view>
      <view wx:if="{{order.status==='delivered'}}" class="text-action danger-text" bindtap="notReceived">没有收到快递</view>
      <view wx:if="{{canRequestCancel}}" class="text-action" bindtap="requestCancel">申请取消 / 联系客服</view>
    </block>
    <block wx:else>
      <view wx:if="{{order.status==='accepted'}}" class="primary-btn {{submitting?'disabled-btn':''}}" bindtap="advance">{{submitting?'正在提交…':'确认已取件'}}</view>
      <view wx:elif="{{order.status==='picked'}}" class="primary-btn {{submitting?'disabled-btn':''}}" bindtap="advance">{{submitting?'正在提交…':'开始配送'}}</view>
      <view wx:elif="{{order.status==='delivering'}}" class="primary-btn {{submitting?'disabled-btn':''}}" bindtap="confirmDelivered">{{submitting?'正在提交…':'确认已送达'}}</view>
      <view wx:elif="{{order.status==='delivered'}}" class="status-notice">
        <view class="notice-dot"></view>
        <text>等待用户确认收货</text>
      </view>
      <view wx:if="{{showExceptionHint}}" class="text-action danger-text">订单遇到问题？请联系客服</view>
      <!-- 转单入口：仅「已接单、未取件」出现。用 .text-action 灰色纯文字，刻意弱于上面的主按钮。
           （试过做成「发短信给用户」那种浅蓝按钮，底部变成两个按钮夹一行灰字，观感更差，已改回。） -->
      <view wx:if="{{canTransfer}}" class="text-action" bindtap="transferOrder">临时有事？转单给其他骑手</view>
    </block>
  </view>

  <view wx:if="{{role === 'user' && !reviewMode && showPayQr}}" class="pay-qr-mask show" catchtap="closePayQr" catchtouchmove="noop"></view>
  <view wx:if="{{role === 'user' && !reviewMode && showPayQr}}" class="pay-qr-modal show">
    <view class="qr-card">
      <view class="qr-title">微信扫码支付</view>
      <view class="qr-price">¥{{order.originalPrice - order.discountAmount}}</view>
      <image class="qr-image" src="{{payQrImage}}" mode="aspectFit" show-menu-by-longpress="{{true}}" bindtap="previewPayQr" />
      <view class="qr-tip">由于个体工商证还没下来，暂时只能扫码支付</view>
      <view class="qr-tip">长按二维码保存图片 → 退出小程序进行扫码 → 支付 → 返回本页</view>
      <view class="qr-tip">支付成功后回到本页会自动确认</view>
      <button class="qr-done-btn" bindtap="closePayQr">我已支付完成</button>
    </view>
  </view>
</view>

<!-- 骨架屏：无本地缓存、正在拉详情时占位（形状对齐「状态头 + 进度卡 + 信息卡」） -->
<view wx:elif="{{loading}}" class="page detail-page" aria-hidden="true">
  <view class="sk sk-hero"></view>
  <view class="card progress-card">
    <view class="sk sk-line sk-w-240"></view>
    <view class="sk sk-block sk-gap-lg"></view>
  </view>
  <view class="card info-card">
    <view class="sk sk-line sk-w-240"></view>
    <view class="sk sk-line"></view>
    <view class="sk sk-line"></view>
    <view class="sk sk-line short"></view>
  </view>
</view>
