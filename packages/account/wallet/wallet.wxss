.wallet-page { padding-top:25rpx; }.balance-card { padding:36rpx; color: var(--color-on-accent); border-radius:36rpx; background:linear-gradient(145deg,#266a56,#20aa7a); box-shadow:0 20rpx 45rpx rgba(32,170,122,.2); }.balance-label { opacity:.72; font-size:23rpx; }.balance-num { margin:14rpx 0 32rpx; font-size:64rpx; font-weight:800; }.balance-num text { margin-right:8rpx; font-size:30rpx; }.balance-meta { display:flex; align-items:center; }.balance-meta>view:not(.meta-line) { display:flex; flex:1; flex-direction:column; }.balance-meta>view:last-child { align-items:flex-end; }.balance-meta text:first-child { font-size:28rpx; font-weight:700; }.balance-meta text:last-child { margin-top:6rpx; opacity:.68; font-size:20rpx; }.meta-line { width:1rpx; height:55rpx; background:rgba(255,255,255,.2); }.withdraw { margin-top:34rpx; height:82rpx; line-height:82rpx; text-align:center; color:var(--color-success); background:var(--color-surface); border-radius:23rpx; font-weight:800; }.observe-tip { display:flex; gap:14rpx; margin-top:20rpx; padding:20rpx; border-radius:20rpx; color:var(--color-text-2); background:var(--color-primary-soft); font-size:22rpx; line-height:1.55; }.tip-icon { flex:none; width:38rpx; height:38rpx; line-height:38rpx; text-align:center; color:var(--color-primary); background:var(--color-surface); border-radius:50%; font-weight:800; }.record-title { margin:38rpx 4rpx 18rpx; }.record-card { padding:0 28rpx; }.record-row { display:flex; align-items:center; min-height:112rpx; border-bottom:1rpx solid var(--color-divider); }.record-row:last-child { border:0; }.record-icon { display:flex; align-items:center; justify-content:center; width:54rpx; height:54rpx; margin-right:18rpx; border-radius:17rpx; background:var(--color-success-soft); }.record-icon image { width:31rpx; height:31rpx; }.record-icon.out { background:var(--color-danger-soft); }.record-copy { flex:1; font-weight:600; }.record-copy view:last-child { margin-top:6rpx; color:var(--color-hint); font-size:20rpx; font-weight:400; }.record-amount { font-weight:800; }.record-amount.green { color:var(--color-success); }
